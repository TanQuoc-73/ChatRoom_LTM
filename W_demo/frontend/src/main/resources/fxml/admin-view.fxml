<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="chat.client.fx.AdminController"
      spacing="20" alignment="CENTER" style="-fx-padding: 20;">

    <Label text="Quản Lý Người Dùng" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>

    <TableView fx:id="userTable" prefHeight="600" prefWidth="1000">
        <columns>
            <TableColumn fx:id="colId" text="ID" prefWidth="80"/>
            <TableColumn fx:id="colUsername" text="Username" prefWidth="200"/>
            <TableColumn fx:id="colEmail" text="Email" prefWidth="250"/>
            <TableColumn fx:id="colRole" text="Vai Trò" prefWidth="100"/>
            <TableColumn fx:id="colActive" text="Hoạt Động" prefWidth="100"/>
            <TableColumn fx:id="colCreatedAt" text="Ngày Tạo" prefWidth="200"/>
        </columns>
    </TableView>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <Button text="Xóa" onAction="#onDeleteUserButtonClick"/>
        <Button text="Khóa" onAction="#onLockUserButtonClick"/>
        <Button text="Mở Khóa" onAction="#onUnlockUserButtonClick"/>
    </HBox>

</VBox>