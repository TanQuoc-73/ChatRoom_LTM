<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="chat.client.fx.AdminController">

    <top>
        <HBox spacing="10" padding="10">
            <Label text="🛡 ADMIN MODERATION"
                   style="-fx-font-size:18px;-fx-font-weight:bold"/>
            <Button text="🔄 Refresh" onAction="#loadData"/>
        </HBox>
    </top>

    <center>
        <TableView fx:id="table">

            <columns>
                <TableColumn fx:id="colId" text="ID" prefWidth="60"/>
                <TableColumn fx:id="colUser" text="User" prefWidth="120"/>
                <TableColumn fx:id="colCaption" text="Caption" prefWidth="300"/>
                <TableColumn fx:id="colViolation" text="⚠" prefWidth="60"/>
                <TableColumn fx:id="colAction" text="Action" prefWidth="260"/>
            </columns>

        </TableView>
    </center>
</BorderPane>
