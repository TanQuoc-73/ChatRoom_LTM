<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.media.MediaView?>

<StackPane fx:id="root"
           xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="chat.client.fx.LoginController"
           styleClass="root">

    <MediaView fx:id="backgroundVideo" 
               fitWidth="${root.width}" 
               fitHeight="${root.height}"
               preserveRatio="false"/>

    <HBox fx:id="mainContainer" alignment="CENTER_RIGHT" styleClass="right-container">
        
        <VBox styleClass="web-container" spacing="0">
            <Label text="Đăng Nhập" styleClass="web-login-header"/>
            
            <VBox styleClass="web-login-form" spacing="10"> <TextField fx:id="usernameField"
                           promptText="Tên đăng nhập"
                           styleClass="web-input-field"/>
                
                <HBox styleClass="web-password-row" alignment="CENTER_LEFT">
                    <PasswordField fx:id="passwordField"
                                   promptText="Mật khẩu"
                                   styleClass="web-password-input"
                                   HBox.hgrow="ALWAYS"/>
                    
                    <TextField fx:id="passwordVisibleField"
                               promptText="Mật khẩu"
                               visible="false"
                               managed="false"
                               styleClass="web-password-input-visible"
                               HBox.hgrow="ALWAYS"/>
                    
                    <Button fx:id="togglePasswordBtn"
                            text="👁"
                            onAction="#onTogglePassword"
                            styleClass="web-password-toggle"/>
                </HBox>
                
                <HBox alignment="CENTER_RIGHT" style="-fx-padding: -5 0 5 0;">
                     <Label text="Quên mật khẩu?"
                           styleClass="web-forgot-password"
                           onMouseClicked="#onForgotPassword"/>
                </HBox>
                
                <Button fx:id="loginButton"
                        text="Đăng nhập"
                        onAction="#onLogin"
                        styleClass="web-login-button"/>
                
                <Label fx:id="messageLabel"
                        text=""
                        styleClass="web-message-label"/>
                
                <HBox alignment="CENTER" spacing="4" style="-fx-padding: 5 0 0 0;">
                    <Label text="Chưa có tài khoản?" styleClass="web-link-text"/>
                    <Hyperlink text="Đăng ký ngay"
                               onAction="#onRegister"
                               styleClass="web-link-hyper"/>
                </HBox>
            </VBox>
        </VBox>
    </HBox>
</StackPane>